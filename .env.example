# ════════════════════════════════════════════════════════════════
#  DuoBalance API — Backend environment variables
# ════════════════════════════════════════════════════════════════
#
#  LOCAL (dev):
#    Copia este archivo a .env y rellena con tus valores reales.
#    El archivo .env está gitignored (nunca se commitea).
#
#  PRODUCCIÓN (Oracle VM):
#    Define estas variables como environment vars del servidor
#    (pm2 ecosystem / docker / systemd). NO uses un .env commiteado.
#
# ════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# ── Database (Postgres) ──────────────────────────────────────────
DATABASE_URL=postgresql://duobalance:password@host:5432/duobalance

# ── Auth ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=cambia-esto-en-prod

# ── Email (Resend) ──────────────────────────────────────────────
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Email (Brevo) — alternativa ─────────────────────────────────
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# ── Email sender ─────────────────────────────────────────────────
MAIL_FROM=onboarding@resend.dev

# ── Frontend (para links de verificación / reset) ───────────────
# Dev:  http://localhost:8081
# Prod: https://duobalance.pages.dev
FRONTEND_URL=http://localhost:8081

# ── CORS (orígenes permitidos, separados por coma) ─────────────
# Dev:   http://localhost:8081,http://localhost:8082
# Prod:  https://duobalance.pages.dev
CORS_ORIGINS=http://localhost:8081,http://localhost:8082